// ─────────────────────────────────────────────────────────────
// B7A6 Courier & Logistics Platform — Prisma Schema (PostgreSQL)
// Models: User, Hub, Parcel, ParcelStatusHistory, Payment, AuditLog
// 3 strict roles: ADMIN, COURIER, CUSTOMER
// Soft deletes via `isDeleted Boolean @default(false)`
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  COURIER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ParcelStatus {
  PENDING // created, awaiting payment
  ACCEPTED // paid + courier assigned
  PICKED_UP // courier collected the parcel
  IN_TRANSIT // moving between hubs / to destination
  OUT_FOR_DELIVERY // courier heading to receiver
  DELIVERED
  CANCELLED
}

enum ParcelType {
  DOCUMENT
  PARCEL
  FRAGILE
  PERISHABLE
}

enum PaymentMethod {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum AuditAction {
  REGISTER
  LOGIN
  GOOGLE_LOGIN
  LOGOUT
  ROLE_CHANGED
  PARCEL_CREATED
  PARCEL_STATUS_CHANGED
  PARCEL_ASSIGNED
  PARCEL_DELETED
  PAYMENT_CREATED
  PAYMENT_VERIFIED
  PAYMENT_FAILED
  HUB_CREATED
  HUB_UPDATED
  HUB_DELETED
}

// ── Models ────────────────────────────────────────────────────

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  password        String? // null for Google-only accounts
  name            String
  phone           String?
  avatarUrl       String?
  role            Role          @default(CUSTOMER)
  status          UserStatus    @default(ACTIVE)
  provider        AuthProvider  @default(LOCAL)
  googleId        String?       @unique
  isEmailVerified Boolean       @default(false)
  rating          Float         @default(0)
  totalDeliveries Int           @default(0)
  isAvailable     Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  isDeleted       Boolean       @default(false)

  parcelsAsSender      Parcel[]                    @relation("SenderParcels")
  parcelsAsCourier     Parcel[]                    @relation("CourierParcels")
  statusChanges        ParcelStatusHistory[]       @relation("StatusChangesByUser")
  payments             Payment[]
  auditLogs            AuditLog[]                  @relation("ActorLogs")

  @@index([role, status])
  @@index([createdAt])
  @@index([isDeleted])
}

model Hub {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  code      String  @unique
  zoneCode  String  @unique // drives zone-based pricing
  zoneName  String
  address   String
  city      String?
  lat       Float?
  lng       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  originParcels      Parcel[] @relation("OriginHubParcels")
  destinationParcels Parcel[] @relation("DestinationHubParcels")

  @@index([isDeleted, zoneCode])
  @@index([city])
}

model Parcel {
  id             String       @id @default(uuid()) @db.Uuid
  trackingNumber String       @unique
  status         ParcelStatus @default(PENDING)
  type           ParcelType   @default(PARCEL)
  weightKg       Float        @default(0)
  dimensions     String?
  fee            Decimal      @db.Decimal(10, 2)
  currency       String       @default("BDT")

  senderId         String  @db.Uuid
  courierId        String? @db.Uuid
  originHubId      String? @db.Uuid
  destinationHubId String? @db.Uuid

  senderName    String
  senderPhone   String
  senderAddress String
  senderCity    String?
  receiverName  String
  receiverPhone String
  receiverAddress String
  receiverCity    String?

  notes        String?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  sender          User                @relation("SenderParcels", fields: [senderId], references: [id])
  courier         User?               @relation("CourierParcels", fields: [courierId], references: [id])
  originHub       Hub?                @relation("OriginHubParcels", fields: [originHubId], references: [id])
  destinationHub  Hub?                @relation("DestinationHubParcels", fields: [destinationHubId], references: [id])
  payment         Payment?
  statusHistory   ParcelStatusHistory[]

  @@index([senderId, courierId, status])
  @@index([trackingNumber])
  @@index([status, isDeleted])
  @@index([originHubId, destinationHubId])
  @@index([createdAt])
  @@index([isDeleted])
}

model ParcelStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  parcelId   String       @db.Uuid
  status     ParcelStatus
  fromStatus ParcelStatus?
  location   String?
  note       String?
  changedById String?     @db.Uuid

  createdAt  DateTime     @default(now())

  parcel    Parcel  @relation(fields: [parcelId], references: [id])
  changedBy User?   @relation("StatusChangesByUser", fields: [changedById], references: [id])

  @@index([parcelId, createdAt])
  @@index([status])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  parcelId              String        @unique @db.Uuid
  senderId              String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("BDT")
  method                PaymentMethod @default(STRIPE)
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  transactionId         String?       @unique
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  parcel Parcel @relation(fields: [parcelId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])

  @@index([status])
  @@index([senderId, status])
  @@index([createdAt])
  @@index([isDeleted])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime    @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}